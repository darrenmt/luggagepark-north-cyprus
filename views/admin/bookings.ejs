<%- include('_top') %>
<div class="page-head row"><h1>Bookings</h1>
  <div class="actions"><% if (can('manager')) { %><a class="btn" href="/admin/bookings.csv?<%= qs %>">Export CSV</a><% } %><a class="btn btn-primary" href="/admin/bookings/new">New booking</a></div></div>
<form class="filters" method="get">
  <input name="q" value="<%= q.q || '' %>" placeholder="Search ref, name, email, phone, tag" aria-label="Search">
  <select name="status" aria-label="Status"><option value="">Any status</option><% STATUSES.forEach(function(s){ %><option value="<%= s %>"<%= q.status===s?' selected':'' %>><%= STATUS_LABEL[s] %></option><% }) %></select>
  <select name="pay" aria-label="Payment"><option value="">Any payment</option><% PAY.forEach(function(p){ %><option value="<%= p %>"<%= q.pay===p?' selected':'' %>><%= p[0].toUpperCase()+p.slice(1) %></option><% }) %></select>
  <% if (!(me.role==='staff' && me.location_id)) { %><select name="location" aria-label="Location"><option value="">All locations</option><% locations.forEach(function(l){ %><option value="<%= l.id %>"<%= +q.location===l.id?' selected':'' %>><%= l.name_en %></option><% }) %></select><% } %>
  <label class="inline">From <input type="date" name="from" value="<%= q.from || '' %>"></label>
  <label class="inline">To <input type="date" name="to" value="<%= q.to || '' %>"></label>
  <select name="sort" aria-label="Sort"><option value="drop">Sort by drop-off</option><option value="pickup"<%= q.sort==='pickup'?' selected':'' %>>By collection</option><option value="created"<%= q.sort==='created'?' selected':'' %>>By date booked</option><option value="total"<%= q.sort==='total'?' selected':'' %>>By total</option></select>
  <select name="dir" aria-label="Direction"><option value="desc">Newest first</option><option value="asc"<%= q.dir==='asc'?' selected':'' %>>Oldest first</option></select>
  <button class="btn" type="submit">Filter</button><a class="linkbtn" href="/admin/bookings">Clear</a>
</form>
<p class="muted small"><%= total.n %> bookings · <%= total.bags %> bags<% if (can('manager')) { %> · <%= money(total.v) %><% } %></p>
<% if (!rows.length) { %><div class="panel"><p>No bookings match these filters. <a href="/admin/bookings">Clear filters</a> or <a href="/admin/bookings/new">add one</a>.</p></div><% } else { %>
<div class="table-wrap">
<table class="tbl">
  <thead><tr><th>Ref</th><th>Customer</th><th>Location</th><th>Drop-off</th><th>Collect by</th><th class="num">Bags</th><th class="num">Total</th><th>Status</th><th>Paid</th></tr></thead>
  <tbody>
  <% rows.forEach(function(b){ %>
  <tr data-href="/admin/bookings/<%= b.id %>">
    <td><a href="/admin/bookings/<%= b.id %>"><b><%= b.ref %></b></a><% if (b.source!=='web') { %> <small class="muted"><%= b.source %></small><% } %></td>
    <td><%= b.customer_name %><br><small class="muted"><%= b.phone || b.email %></small></td>
    <td><%= b.loc %></td><td><%= fmt(b.dropoff_at) %></td><td><%= fmt(b.pickup_at) %></td>
    <td class="num"><%= b.bags %></td><td class="num"><%= money(b.total) %></td>
    <td><%- include('_status', {s: b.status}) %></td><td><span class="pay pay-<%= b.payment_status %>"><%= b.payment_status %></span></td>
  </tr><% }) %>
  </tbody>
</table>
</div>
<% if (pages > 1) { %><nav class="pager" aria-label="Pages"><% if (page>1) { %><a class="btn" href="?<%= qs %>&page=<%= page-1 %>">Previous</a><% } %><span>Page <%= page %> of <%= pages %></span><% if (page<pages) { %><a class="btn" href="?<%= qs %>&page=<%= page+1 %>">Next</a><% } %></nav><% } %>
<% } %>
<%- include('_bottom') %>
