<%- include('_top') %>
<div class="page-head"><h1>Activity log</h1><p class="muted">Every sign-in, booking change and settings edit. Times are UTC.</p></div>
<div class="table-wrap"><table class="tbl">
  <thead><tr><th>When</th><th>Who</th><th>What</th><th>Item</th><th>Detail</th></tr></thead>
  <tbody><% rows.forEach(function(r){ %><tr><td><%= r.created_at %></td><td><%= r.user_name %></td><td><%= r.action %></td>
    <td><% if (r.entity==='booking' && r.entity_id) { %><a href="/admin/b/<%= r.entity_id %>"><%= r.entity_id %></a><% } else { %><%= r.entity || '' %> <%= r.entity_id || '' %><% } %></td>
    <td class="detail"><%= (r.detail || '').slice(0,140) %></td></tr><% }) %></tbody>
</table></div>
<nav class="pager"><% if (page>1) { %><a class="btn" href="?page=<%= page-1 %>">Newer</a><% } %><% if (rows.length===100) { %><a class="btn" href="?page=<%= page+1 %>">Older</a><% } %></nav>
<%- include('_bottom') %>
