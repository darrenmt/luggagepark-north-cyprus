# Copy to .env and fill in. Real environment variables override this file.
NODE_ENV=production
PORT=3000
SITE_URL=https://luggagepark.com

# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me

# First owner account (only used the very first time the database is created)
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=choose-a-strong-password

# Where the SQLite database lives. On Render/Railway point this at a persistent disk.
DATA_DIR=./data

# Email (optional). Without these, bookings work but emails are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LuggagePark <bookings@luggagepark.com>
